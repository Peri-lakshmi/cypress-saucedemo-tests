# This file exists only so Git keeps this folder in the repository.
#
# Git doesn't track empty folders on its own, and cypress/reports/ starts
# out empty since the actual report files are generated when you run:
#
#   npm run test:report
#
# The generated report files themselves (merged-report.html, .json, and
# the assets/ folder they come with) are intentionally ignored by
# .gitignore, since they're regenerated fresh every time you run the
# tests - there's no reason to commit them.
